execute_process(COMMAND "${CMAKE_COMMAND}" -E env "BOOZMN_FIXTURE=${FIXTURE}"
  "${READER}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
if(STATUS EQUAL 0 OR NOT "${OUTPUT}${ERROR}" MATCHES "${EXPECTED}")
  message(FATAL_ERROR "Expected nonzero exit containing '${EXPECTED}': ${STATUS}\n${OUTPUT}\n${ERROR}")
endif()
